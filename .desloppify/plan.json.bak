    "log-action-consolidation": {
      "name": "log-action-consolidation",
      "description": "Merge duplicate LoggingMixin and LogMixin implementations: both define identical log_action with same deferred imports and logic; consolidate into single mixin, standardize parameter order, add type annotations, fix signal discarding caller args",
      "issue_ids": [
        "review::.::holistic::api_surface_coherence::deprecated_signal_discards_caller_args",
        "review::.::holistic::cross_module_architecture::log_action_duplicate_implementations",
        "review::.::holistic::api_surface_coherence::log_action_missing_type_annotations",
        "review::.::holistic::api_surface_coherence::log_action_param_order_mismatch",
        "review::.::holistic::cross_module_architecture::arch-001",
        "review::.::holistic::cross_module_architecture::arch-002",
        "review::.::holistic::convention_outlier::conv-003",
        "review::.::holistic::naming_quality::name-003"
      ],
      "created_at": "2026-03-14T14:54:06+00:00",
      "updated_at": "2026-03-16T07:24:06+00:00",
      "auto": false,
      "cluster_key": "",
      "action": null,
      "user_modified": true,
      "action_steps": [
        {
          "title": "Merge LoggingMixin and LogMixin into single canonical mixin with typed signature",
          "detail": "app/eventyay/base/models/base.py line 43 has LoggingMixin.log_action with parameter order (action, data, user, person, orga, content_object, api_token, auth, save). app/eventyay/base/models/mixins.py line 27 has LogMixin.log_action with order (action, data, user, api_token, auth, person, orga, content_object, save). Delete LoggingMixin from base.py and update LoggedModel (line 123) to inherit from LogMixin. Then update the import in app/eventyay/base/models/__init__.py to export LogMixin as the single canonical mixin. Add type annotations: action: str, data: dict | None = None, user: Any = None, api_token: Any = None, auth: Any = None, person: Any = None, orga: bool = False, content_object: Any = None, save: bool = True.",
          "effort": "medium",
          "issue_refs": [
            "review::.::holistic::cross_module_architecture::log_action_duplicate_implementations",
            "review::.::holistic::api_surface_coherence::log_action_missing_type_annotations",
            "review::.::holistic::api_surface_coherence::log_action_param_order_mismatch",
            "review::.::holistic::cross_module_architecture::arch-001",
            "review::.::holistic::cross_module_architecture::arch-002",
            "review::.::holistic::convention_outlier::conv-003"
          ]
        },
        {
          "title": "Fix EventPluginSignal.connect to pass caller args through to super()",
          "detail": "signals.py:242: replace hard-coded super().connect(receiver, sender=None, weak=True, dispatch_uid=None) with super().connect(receiver, sender=sender, weak=weak, dispatch_uid=dispatch_uid) to stop silently dropping caller's arguments",
          "effort": "trivial",
          "issue_refs": [
            "review::.::holistic::api_surface_coherence::deprecated_signal_discards_caller_args"
          ],
          "done": true
        },
        {
          "title": "Update all import sites after merging LoggingMixin and LogMixin",
          "detail": "Run: grep -rn 'LogMixin\\|LoggingMixin' app/eventyay/ --include='*.py' | grep 'import'. Confirmed import sites: app/eventyay/base/models/auth.py line 46 'from .base import LoggingMixin'; app/eventyay/base/models/__init__.py exports both. After deleting LoggingMixin from app/eventyay/base/models/base.py: update auth.py line 46 to 'from .mixins import LogMixin'; update app/eventyay/base/models/__init__.py to export LogMixin only (remove LoggingMixin entry). Search for any other callers with: grep -rn 'LoggingMixin' app/ --include='*.py'.",
          "effort": "small",
          "issue_refs": [
            "review::.::holistic::cross_module_architecture::log_action_duplicate_implementations"
          ]
        },
        {
          "title": "Add type annotations to all 9 log_action parameters",
