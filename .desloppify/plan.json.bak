        "review::.::holistic::mid_level_elegance::event_model_business_rule_import"
      ],
      "created_at": "2026-03-15T09:42:44+00:00",
      "updated_at": "2026-03-16T07:25:01+00:00",
      "auto": false,
      "cluster_key": "",
      "action": null,
      "user_modified": true,
      "action_steps": [
        {
          "title": "Fix base/forms imports of control and base/payment imports of presale",
          "detail": "In app/eventyay/base/forms/questions.py line 62: 'from eventyay.control.forms import ExtFileField, SplitDateTimeField' inverts layer dependency. ExtFileField is defined at app/eventyay/control/forms/__init__.py line 183 and SplitDateTimeField at line 327. Move both class bodies to app/eventyay/base/forms/widgets.py (already exists), then update app/eventyay/control/forms/__init__.py to re-import from base/forms/widgets.py, and update app/eventyay/base/forms/questions.py line 62 to import from app/eventyay/base/forms/widgets. In app/eventyay/base/payment.py line 47: 'from eventyay.presale.views import get_cart, get_cart_total' \u2014 change to pass request into a pluggable hook: define a get_cart_fn callable on BasePaymentProvider (default: None), set by presale in an AppConfig.ready() receiver. Replace direct calls with self.get_cart_fn(request) guarded by if self.get_cart_fn.",
          "effort": "medium",
          "issue_refs": [
            "review::.::holistic::cross_module_architecture::arch_base_forms_imports_control",
            "review::.::holistic::cross_module_architecture::arch_base_payment_imports_presale_views",
            "review::.::holistic::mid_level_elegance::base_payment_presale_dep",
            "review::.::holistic::abstraction_fitness::base_payment_reverse_dep"
          ]
        },
        {
          "title": "Fix base/models/devices.py api import and cache LogMixin deferred api imports",
          "detail": "In app/eventyay/base/models/devices.py line 10: 'from eventyay.api.auth.devicesecurity import DEVICE_SECURITY_PROFILES'. The constant is defined at app/eventyay/api/auth/devicesecurity.py line 83 as a dict. Move DEVICE_SECURITY_PROFILES from devicesecurity.py to a new file app/eventyay/base/consts.py (or append to app/eventyay/consts.py if it exists). Update devices.py to import from app/eventyay/base/consts. Update app/eventyay/api/auth/devicesecurity.py to import DEVICE_SECURITY_PROFILES from app/eventyay/base/consts instead of defining it. In app/eventyay/base/models/mixins.py LogMixin.log_action (lines 51-58): the deferred 'from eventyay.api.models import OAuthAccessToken, OAuthApplication' and 'from eventyay.api.webhooks import notify_webhooks' run on every log_action call. Add module-level _oauth_token_cls = None at top of file and populate lazily with threading.Lock on first call; or move to TYPE_CHECKING block if only used for isinstance checks.",
          "effort": "medium",
          "issue_refs": [
            "review::.::holistic::cross_module_architecture::arch_base_imports_api_devicesecurity",
            "review::.::holistic::cross_module_architecture::arch_logmixin_deferred_api_imports"
          ]
        },
        {
          "title": "Fix base/models/event.py deferred presale/cfp imports and reduce base/models hub re-export",
          "detail": "In app/eventyay/base/models/event.py lines 2081 and 2091: deferred 'from eventyay.presale.style import regenerate_css' inside Event._set_state(). Lines 2087 and 2097 call regenerate_css.apply_async. Line 2583: deferred 'from eventyay.cfp.flow import CfPFlow'. Fix: emit Django signals instead. In app/eventyay/base/signals.py (or create it), define event_css_regenerate = Signal() and cfp_flow_requested = Signal(providing_args=['event']). In event.py, replace each deferred import + call with event_css_regenerate.send(sender=Event, event=self). In presale/apps.py ready() connect regenerate_css to event_css_regenerate. Also: app/eventyay/base/models/room.py line 13 imports I18nAwareModelSerializer from app/eventyay/api/serializers/i18n.py line 42 \u2014 move I18nAwareModelSerializer to app/eventyay/base/serializers.py (create file) and update api/serializers/i18n.py to import from there.",
          "effort": "large",
          "issue_refs": [
            "review::.::holistic::cross_module_architecture::arch_base_event_model_imports_presale_cfp",
            "review::.::holistic::cross_module_architecture::arch_base_models_hub_oversize",
            "review::.::holistic::cross_module_architecture::arch-003",
            "review::.::holistic::mid_level_elegance::event_model_business_rule_import"
          ]
        }
