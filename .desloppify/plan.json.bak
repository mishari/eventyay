      "action_steps": [
        {
          "title": "Fix Optional annotations for nullable dict params in mail() and service functions",
          "detail": "In app/eventyay/base/services/mail.py line 74: 'context: dict[str, Any] = None' is invalid \u2014 dict cannot be None without Optional. Change to 'context: dict[str, Any] | None = None'. Line 80: 'headers: dict = None' \u2014 change to 'headers: dict | None = None'. Line 344 in mail_send_task: 'headers: dict = None' \u2014 same fix. In app/eventyay/base/services/cart.py line 190: CartManager.__init__ 'invoice_address: InvoiceAddress = None' \u2014 change to 'invoice_address: InvoiceAddress | None = None'. In app/eventyay/base/services/orders.py line 2671: cancel_order task 'user: int = None' \u2014 change to 'user: int | None = None'. Search the whole codebase: grep -rn ': dict = None\\|: int = None\\|: str = None\\|: list = None' app/eventyay/ to find all remaining instances of this pattern and fix each.",
          "effort": "small",
          "issue_refs": [
            "review::.::holistic::type_safety::ts-01",
            "review::.::holistic::type_safety::ts-05",
            "review::.::holistic::type_safety::TS-01",
            "review::.::holistic::type_safety::TS-03"
