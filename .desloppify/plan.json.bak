    "authorization-consistency": {
      "name": "authorization-consistency",
      "description": "Fix view-level authorization gaps in orga/admin.py and orga/permissions.py: add AdministratorPermissionRequiredMixin to AttendeeListView and SubmissionListView, consolidate dual auth systems (EventPermissionRequiredMixin vs rules library PermissionRequired), and extract magic permission string literals into a shared constants module",
      "issue_ids": [
        "review::.::holistic::authorization_consistency::attendee_list_missing_mixin",
        "review::.::holistic::authorization_consistency::dual_auth_systems",
        "review::.::holistic::authorization_consistency::magic_permission_strings",
        "review::.::holistic::authorization_consistency::submission_list_missing_mixin"
      ],
      "created_at": "2026-03-16T07:05:45+00:00",
      "updated_at": "2026-03-16T07:23:42+00:00",
      "auto": false,
      "cluster_key": "",
      "action": null,
      "user_modified": true,
      "action_steps": [
        {
          "title": "Add AdministratorPermissionRequiredMixin to AttendeeListView and SubmissionListView in orga/admin.py",
          "detail": "In app/eventyay/control/views/admin.py line 156, AttendeeListView extends only ListView with no authentication mixin; line 172 does inline has_active_staff_session check inside get_queryset(). At line 269, SubmissionListView mirrors the same pattern (no mixin, inline check at line 287). Change both class declarations to add AdministratorPermissionRequiredMixin (imported from app/eventyay/control/permissions.py line 143) as the FIRST base class before ListView, then delete the inline has_active_staff_session if-block from each get_queryset() method.",
          "effort": "small",
          "issue_refs": [
            "review::.::holistic::authorization_consistency::attendee_list_missing_mixin",
            "review::.::holistic::authorization_consistency::submission_list_missing_mixin"
          ]
        },
        {
          "title": "Extract permission string literals into orga/permissions_constants.py",
          "detail": "Grep for magic permission strings in app/eventyay/orga/ with: grep -rn 'permission_required\\|has_perm\\|PermissionRequired' app/eventyay/orga/. Permission strings like 'orga.view_submissions', 'orga.change_settings', etc. appear in PermissionRequired subclasses in app/eventyay/orga/views/submission.py and app/eventyay/orga/views/event.py. Create app/eventyay/orga/permissions_constants.py with named constants PERM_VIEW_SUBMISSIONS = 'orga.view_submissions', PERM_CHANGE_SETTINGS = 'orga.change_settings', etc. Replace each inline string in all orga view files with the named constant.",
          "effort": "small",
          "issue_refs": [
            "review::.::holistic::authorization_consistency::magic_permission_strings"
          ]
        },
        {
          "title": "Document and consolidate the dual auth systems (EventPermissionRequiredMixin vs rules PermissionRequired)",
          "detail": "The control panel uses EventPermissionRequiredMixin defined at app/eventyay/control/permissions.py line 47. The orga side uses EventPermissionRequired from app/eventyay/common/views/mixins.py line 277, which extends rules library PermissionRequired. These are two different mixin hierarchies doing similar jobs. Create an ADR doc at app/eventyay/orga/docs/adr-001-auth-mixins.md explaining the split, OR migrate all orga views that use EventPermissionRequired to also check the has_active_staff_session path by wrapping EventPermissionRequired. At minimum add a code comment in both app/eventyay/common/views/mixins.py line 277 and app/eventyay/control/permissions.py line 47 cross-referencing each other.",
          "effort": "medium",
          "issue_refs": [
            "review::.::holistic::authorization_consistency::dual_auth_systems"
          ]
        },
        {
          "title": "Add regression tests for the mixin and permission string fixes",
          "detail": "Add tests in app/tests/tickets/control/test_admin_views.py (create file if missing) for: (1) anonymous GET /control/admin/attendees/ returns 302 redirect to login; (2) authenticated staff-session user GET /control/admin/attendees/ returns 200; (3) non-staff authenticated user GET /control/admin/attendees/ returns 302 redirect; mirror same 3 cases for /control/admin/submissions/. Use the test client fixtures from app/tests/tickets/control/conftest.py or app/tests/tickets/conftest.py (client, user fixtures).",
          "effort": "small",
          "issue_refs": [
            "review::.::holistic::authorization_consistency::attendee_list_missing_mixin",
            "review::.::holistic::authorization_consistency::submission_list_missing_mixin"
          ]
        }
      ],
      "depends_on_clusters": [
        "api-views-auth-bypass"
      ]
    }
  },
