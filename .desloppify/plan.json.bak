ervice signatures)\n\n## Coverage Ledger\n- AC-01 -> cluster \"service-function-signatures\"\n- AC-02 -> cluster \"service-function-signatures\"\n- AC-03 -> cluster \"service-return-contracts\"\n- AC-04 -> cluster \"convention-and-naming-fixes\"\n- AC-05 -> cluster \"service-layer-cleanup\"\n- AGD-01 -> cluster \"ai-debt-cleanup\"\n- AGD-02 -> cluster \"ai-debt-cleanup\"\n- CC-01 -> cluster \"service-return-contracts\"\n- CC-02 -> cluster \"service-return-contracts\"\n- CC-03 -> cluster \"service-return-contracts\"\n- CC-04 -> cluster \"service-function-signatures\"\n- CC-05 -> cluster \"type-annotation-sweep\"\n- CC-06 -> cluster \"type-annotation-sweep\"\n- DC-01 -> cluster \"design-coherence-fixes\"\n- DC-02 -> cluster \"design-coherence-fixes\"\n- DC-03 -> cluster \"design-coherence-fixes\"\n- DC-04 -> cluster \"design-coherence-fixes\"\n- IC-01 -> cluster \"settings-import-coupling\"\n- IC-02 -> cluster \"settings-import-coupling\"\n- IC-03 -> cluster \"settings-import-coupling\"\n- IM-01 -> cluster \"incomplete-migration-cleanup\"\n- IM-02 -> cluster \"incomplete-migration-cleanup\"\n- IM-03 -> cluster \"submission-deprecated-cleanup\"\n- IM-04 -> cluster \"incomplete-migration-cleanup\"\n- IM-05 -> cluster \"incomplete-migration-cleanup\"\n- LC-01 -> cluster \"service-return-contracts\"\n- LC-02 -> cluster \"service-layer-cleanup\"\n- LC-03 -> cluster \"type-annotation-sweep\"\n- LC-04 -> cluster \"type-annotation-sweep\"\n- PO-01 -> cluster \"base-package-structure\"\n- PO-02 -> cluster \"base-package-structure\"\n- PO-03 -> cluster \"model-naming-and-base-cleanup\"\n- PO-04 -> cluster \"base-package-structure\"\n- TS-01 -> cluster \"type-annotation-sweep\"\n- TS-02 -> cluster \"type-annotation-sweep\"\n- TS-03 -> cluster \"type-annotation-sweep\"\n- TS-04 -> cluster \"type-annotation-sweep\"\n- TS-05 -> cluster \"type-annotation-sweep\"\n- TS-06 -> cluster \"type-annotation-sweep\"\n- TS-ST-01 -> skip \"false-positive-tests-exist\"\n- TS-ST-02 -> cluster \"