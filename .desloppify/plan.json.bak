      ],
      "created_at": "2026-03-15T09:35:17+00:00",
      "updated_at": "2026-03-16T07:08:13+00:00",
      "auto": false,
      "cluster_key": "",
      "action": null,
      "user_modified": true,
      "action_steps": [
        {
