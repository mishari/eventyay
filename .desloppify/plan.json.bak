      "created_at": "2026-03-15T09:38:47+00:00",
      "updated_at": "2026-03-16T07:15:42+00:00",
      "auto": false,
      "cluster_key": "",
      "action": null,
      "user_modified": true,
      "action_steps": [
        {
          "title": "Rename PretalxModel to EventyayModel and update all subclass references",
          "detail": "In app/eventyay/base/models/mixins.py line 205: PretalxModel is defined as 'class PretalxModel(LogMixin, RulesModelMixin, models.Model)'. Add 'EventyayModel = PretalxModel' alias directly below. Add import warnings and a DeprecationWarning in PretalxModel.__init_subclass__ so subclasses using the old name get warned. All 40+ model classes in app/eventyay/base/models/ that inherit from PretalxModel should be updated to inherit from EventyayModel in the same PR.",
          "effort": "medium",
          "issue_refs": [
            "review::.::holistic::high_level_elegance::hle_pretalxmodel_name_namespace_leak"
          ]
        },
        {
          "title": "Merge LoggingMixin and LogMixin and create package boundary map for common/ eventyay_common/ core/",
          "detail": "In app/eventyay/base/models/base.py line 43: LoggingMixin defined. In app/eventyay/base/models/mixins.py line 23: LogMixin defined. Compare both implementations and merge into one canonical class in mixins.py. Add LoggingMixin = LogMixin alias in base.py for backward compatibility. Add a docstring to the canonical LogMixin explaining the log_action contract. For common/, eventyay_common/, core/ package overlap: add a module-level docstring to each __init__.py explaining what it owns and what belongs elsewhere.",
          "effort": "medium",
          "issue_refs": [
            "review::.::holistic::high_level_elegance::hle_dual_logging_mixin",
            "review::.::holistic::high_level_elegance::hle_three_common_packages"
          ]
        },
        {
          "title": "Add EventyayModel deprecation migration guide and update importers",
          "detail": "Run: grep -rn 'from eventyay.base.models.mixins import PretalxModel\\|from eventyay.base.models import PretalxModel' app/ to enumerate all import sites. Update each file to import EventyayModel instead. Run grep against plugins dirs: app/eventyay/plugins/ for the same imports. Add a CHANGELOG entry in the root of the repo documenting that PretalxModel is deprecated and will be removed in a future version. No file creation needed \u2014 edit existing CHANGELOG or docs/ file if it exists.",
          "effort": "small",
          "issue_refs": [
            "review::.::holistic::high_level_elegance::hle_pretalxmodel_name_namespace_leak"
