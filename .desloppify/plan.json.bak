    "base-services-orders-refactor": {
      "name": "base-services-orders-refactor",
      "description": "Extract and deduplicate logic in base/services/orders.py (2856 LOC): split voucher/ticket cancel logic, deduplicate payment cancellation try/except blocks, extract _check_positions 270-line flat loop, fix duplicate refund state constants, break apart the _perform_operations 293-line monolith",
      "issue_ids": [
        "review::.::holistic::low_level_elegance::perform_operations_monolith",
        "review::.::holistic::design_coherence::services_orders_mixed_responsibilities",
        "review::.::holistic::low_level_elegance::cancel_order_duplicated_voucher_ticket_logic",
        "review::.::holistic::low_level_elegance::check_paid_price_change_duplicated_cancel_block",
        "review::.::holistic::low_level_elegance::check_positions_flat_loop",
        "review::.::holistic::low_level_elegance::completed_payment_sum_duplicate_state",
        "review::.::holistic::logic_clarity::duplicate_refund_state_in_filter",
        "review::.::holistic::mid_level_elegance::orders_service_hub"
      ],
      "created_at": "2026-03-14T14:47:44+00:00",
      "updated_at": "2026-03-16T07:15:02+00:00",
      "auto": false,
      "cluster_key": "",
      "action": null,
      "user_modified": true,
      "action_steps": [
        {
          "title": "Extract voucher/ticket cancel helper and deduplicate payment cancellation blocks",
          "detail": "Extract shared voucher restoration + ticket logic from cancel_order into a helper; consolidate the two identical payment cancellation try/except blocks at lines 1817-1869",
          "effort": "large",
          "issue_refs": [
            "review::.::holistic::low_level_elegance::cancel_order_duplicated_voucher_ticket_logic",
            "review::.::holistic::low_level_elegance::check_paid_price_change_duplicated_cancel_block"
          ]
        },
        {
          "title": "Break _check_positions (270 lines) into focused sub-functions and extract _perform_operations dispatch",
          "detail": "Decompose the 270-line _check_positions flat loop into named sub-functions per concern; split the 293-line _perform_operations dispatch chain into individual operation handlers",
          "effort": "large",
          "issue_refs": [
            "review::.::holistic::low_level_elegance::check_positions_flat_loop",
            "review::.::holistic::low_level_elegance::perform_operations_monolith"
          ]
        },
        {
          "title": "Fix duplicate REFUND_STATE_DONE constant and split mixed-responsibility concerns",
          "detail": "Fix repeated state__in filter tuple duplicated across paid_sum, pending_sum, annotate_overpayments in app/eventyay/base/models/orders.py lines 318-376; REFUND_STATE_DONE is defined once at line 1902 \u2014 the duplication is filter patterns, not constant definitions. Extract into a shared helper constant.",
          "effort": "medium",
          "issue_refs": [
            "review::.::holistic::low_level_elegance::completed_payment_sum_duplicate_state",
            "review::.::holistic::logic_clarity::duplicate_refund_state_in_filter",
            "review::.::holistic::design_coherence::services_orders_mixed_responsibilities"
          ]
        }
      ],
      "depends_on_clusters": [
        "arch-layer-violations"
      ]
    },
