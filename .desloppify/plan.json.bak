    "package-layout-fixes": {
      "name": "package-layout-fixes",
      "description": "Fix package layout violations: base/models/ flat directory with 60+ files needs subdirectory grouping, base/models/transaction.py and cache.py are infrastructure files misplaced in models/, base/models/auth_token.py imports from api.versions (upward dependency), core/ package wraps two utility files that belong in base/utils/",
      "issue_ids": [
        "review::.::holistic::package_organization::PO-01",
        "review::.::holistic::package_organization::PO-02",
        "review::.::holistic::package_organization::PO-03",
        "review::.::holistic::package_organization::PO-04"
      ],
      "created_at": "2026-03-15T09:42:15+00:00",
      "updated_at": "2026-03-15T10:22:17+00:00",
      "auto": false,
      "cluster_key": "",
      "action": null,
      "user_modified": true,
      "action_steps": [
        {
          "title": "Move base/models/transaction.py and cache.py to base/infrastructure/ and fix auth_token upward dependency",
          "detail": "In app/eventyay/base/models/transaction.py: this file defines infrastructure-level transactional state, not a domain model. Create app/eventyay/base/infrastructure/ directory; move transaction.py there. Add a deprecated re-import in app/eventyay/base/models/transaction.py: 'from eventyay.base.infrastructure.transaction import *  # deprecated'. Do the same for app/eventyay/base/models/cache.py. In app/eventyay/base/models/auth_token.py line 10: 'from eventyay.api.versions import CURRENT_VERSIONS' is an upward import; move CURRENT_VERSIONS constant to app/eventyay/base/constants.py and import from there.",
          "effort": "medium",
          "issue_refs": [
            "review::.::holistic::package_organization::PO-02",
            "review::.::holistic::package_organization::PO-03"
          ]
        },
        {
          "title": "Plan base/models/ directory grouping and migrate core/ utilities to base/utils/",
          "detail": "app/eventyay/base/models/ has 60 files (confirmed). Create a grouping plan: auth/ (auth.py, auth_token.py, devices.py, teams.py, api_token.py), commerce/ (orders.py, vouchers.py, invoices.py, giftcards.py, payment.py), events/ (event.py, organizer.py, quota.py, seating.py), submissions/ (submission.py, question.py, review.py, schedule.py), infrastructure/ (transaction.py, cache.py). app/eventyay/core/ has 5 utility files (statsd.py, json.py, redis.py, config.py, tasks.py) \u2014 all belong in app/eventyay/base/utils/; move them and delete core/ if empty after moving management commands elsewhere.",
          "effort": "large",
          "issue_refs": [
            "review::.::holistic::package_organization::PO-01",
            "review::.::holistic::package_organization::PO-04"
          ]
        },
        {
          "title": "Create compatibility shims in old locations for moved infrastructure files",
          "detail": "After moving app/eventyay/base/models/transaction.py and cache.py to app/eventyay/base/infrastructure/: leave backward-compatible re-import shims at the original paths (app/eventyay/base/models/transaction.py: 'from eventyay.base.infrastructure.transaction import * # noqa: F401 \u2014 deprecated, will be removed in v2026'). Document the planned removal in the shim file. Add a deprecation warning using warnings.warn() in the shim for any direct imports to help plugin authors migrate.",
          "effort": "small",
          "issue_refs": [
            "review::.::holistic::package_organization::PO-02",
            "review::.::holistic::package_organization::PO-03"
          ]
        },
        {
          "title": "Run full test suite after each file move to catch broken imports",
          "detail": "For each file move in app/eventyay/base/models/ and app/eventyay/core/ utilities: run 'cd app && python manage.py check --deploy' after each move and fix any import errors reported. Then run 'python -m pytest app/tests/ -x -q' to catch broken test imports. This ensures that backward-compat shims at old paths work correctly before the next move. Do each file move in a separate git commit so regressions are easy to bisect.",
          "effort": "small",
          "issue_refs": [
            "review::.::holistic::package_organization::PO-01",
            "review::.::holistic::package_organization::PO-04"
          ]
        }
      ],
      "depends_on_clusters": [
        "base-package-structure"
      ]
    },
    "base-layer-import-fixes": {
      "name": "base-layer-import-fixes",
      "description": "Fix inverted and circular layer dependencies: base/forms imports from control, base/payment.py imports presale views at top level, base/models/devices.py imports from api.auth at module load, base/models/event.py deferred imports presale.style and cfp.flow, LogMixin defers imports from api.models on every call",
      "issue_ids": [
        "review::.::holistic::cross_module_architecture::arch_base_forms_imports_control",
        "review::.::holistic::cross_module_architecture::arch_base_payment_imports_presale_views",
        "review::.::holistic::cross_module_architecture::arch_base_imports_api_devicesecurity",
        "review::.::holistic::cross_module_architecture::arch_logmixin_deferred_api_imports",
        "review::.::holistic::cross_module_architecture::arch_base_event_model_imports_presale_cfp",
