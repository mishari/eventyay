    "review::.::holistic::test_strategy::stable_smoke_tests_have_no_behavioral_assertions": {
      "id": "review::.::holistic::test_strategy::stable_smoke_tests_have_no_behavioral_assertions",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "The stable/ test suite makes only HTTP status-range assertions and provides no validation of eventyay business logic",
      "detail": {
        "holistic": true,
        "dimension": "test_strategy",
        "related_files": [
          "app/tests/stable/test_api.py",
          "app/tests/stable/test_presale.py",
          "app/tests/stable/test_control.py",
          "app/tests/stable/test_common.py"
        ],
        "evidence": [
          "test_presale.py: all assertions are 'assert response.status_code in [200, 301, 302]' with no checks on response content, redirected URL semantics, or returned data.",
          "test_api.py: 'assert response.status_code in [401, 403, 404]' \u2014 a 404 is accepted as 'auth required', masking cases where an endpoint doesn't exist at all.",
          "test_control.py: 'assert response.status_code in [200, 302]' for the organizer dashboard \u2014 passes even if the page renders an error template with status 200.",
          "test_common.py: CSP report test accepts 200, 204, or 400 for malformed JSON input, meaning the endpoint can fail silently and the test still passes.",
          "These tests were added as initial integration scaffolding but do not validate the behaviors they claim to test."
        ],
        "suggestion": "Harden the stable integration tests to assert behavioral invariants: (1) for presale pages, assert response.context or response.content contains expected event name; (2) for API auth tests, assert exactly 401 (not 403/404) with a 'detail' key in JSON; (3) for CSP report endpoint, assert exactly 200 or 204 for valid input and exactly 400 for malformed JSON. These changes turn smoke tests into regression guards without requiring major new infrastructure.",
        "reasoning": "",
        "summary_hash": "f0746b53"
      },
      "status": "fixed",
      "note": "not reported in latest holistic re-import",
