    "review::.::holistic::cross_module_architecture::base_imports_presale_toplevel": {
      "id": "review::.::holistic::cross_module_architecture::base_imports_presale_toplevel",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Core base services and payment abstraction import directly from presale view and signal layers at module scope",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "app/eventyay/base/payment.py",
          "app/eventyay/base/services/cart.py",
          "app/eventyay/base/services/mail.py",
          "app/eventyay/base/pdf.py",
          "app/eventyay/base/views/mixins.py"
        ],
        "evidence": [
          "base/payment.py lines 47-48: `from eventyay.presale.views import get_cart, get_cart_total` and `from eventyay.presale.views.cart import cart_session, get_or_create_cart_id` \u2014 the payment base class depends on presale view utilities",
          "base/services/cart.py line 46: `from eventyay.presale.signals import ...` \u2014 the core cart service imports signals from the presale layer",
          "base/services/mail.py line 54: `from eventyay.presale.ical import get_ical`",
          "base/pdf.py line 45: `from eventyay.presale.style import get_fonts`",
