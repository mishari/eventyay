          "app/eventyay/multidomain/views.py",
          "app/eventyay/features/live/views.py",
          "app/eventyay/common/templatetags/vite.py",
          "app/eventyay/eventyay_common/views/account/basic.py"
        ],
        "evidence": [
          "common/language.py: LANGUAGE_CODES_MAPPING = {language.lower(): language for language in settings.LANGUAGES_INFORMATION}",
          "base/i18n.py: ALLOWED_LANGUAGES = dict(settings.LANGUAGES)",
          "export_schedule_html.py: SERVER_NAME = settings.SITE_URL.split('://')[1]",
          "multidomain/views.py and features/live/views.py: VIDEO_DIST_DIR = cast(Path, settings.STATIC_ROOT) / 'video'",
          "vite.py: MANIFEST_PATH = cast(Path, settings.STATIC_ROOT) / 'schedule-editor/...'",
          "account/basic.py: VALID_LANGUAGE_CODES = {code for code, __ in settings.LANGUAGES}"
        ],
        "suggestion": "Convert all of these to lazy accessors or functools.lru_cache(None) functions (which can be cache-cleared in tests). For Path derivations like VIDEO_DIST_DIR, use a module-level function rather than a constant. For language mappings that are expensive to rebuild, use django.test.signals.setting_changed to invalidate the cache. Coordinate the fix across all 7 files in a single refactor pass.",
