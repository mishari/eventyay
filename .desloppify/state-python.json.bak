    "review::.::holistic::error_consistency::mail_bare_except_swallow": {
      "id": "review::.::holistic::error_consistency::mail_bare_except_swallow",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Six bare 'except:' clauses in mail.py suppress SystemExit/KeyboardInterrupt and three silently discard attachment errors",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "app/eventyay/base/services/mail.py"
        ],
        "evidence": [
          "Line 277: 'except:' around renderer.render() \u2014 logs then sets body_html=None, suppressing all exception types including SystemExit",
          "Line 410: 'except: pass' inside attach-tickets loop \u2014 ticket attachment failure is silently discarded, email is sent without the expected attachment",
          "Lines 458, 471: 'except: logger.exception(...); pass' for invoice and cached-file attachment \u2014 same silent discard pattern; caller receives no signal that attachments are missing"
        ],
        "suggestion": "Replace all bare 'except:' with 'except Exception as e:' to at least preserve chained exceptions and exclude SystemExit/KeyboardInterrupt. For the attachment loops, add a counter and log a warning on the email or order audit log if any attachment was skipped, so operators can detect systematic failures.",
        "reasoning": "",
        "summary_hash": "76e26438"
      },
      "status": "wontfix",
