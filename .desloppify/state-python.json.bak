    "review::.::holistic::cross_module_architecture::base_imports_api_models_toplevel": {
      "id": "review::.::holistic::cross_module_architecture::base_imports_api_models_toplevel",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "base model and config files import from eventyay.api at module scope, inverting the dependency hierarchy",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "app/eventyay/base/models/room.py",
          "app/eventyay/base/models/devices.py",
          "app/eventyay/base/models/auth_token.py",
          "app/eventyay/base/configurations/default_setting.py",
          "app/eventyay/base/shredder.py"
        ],
        "evidence": [
          "base/models/room.py line 13: `from eventyay.api.serializers.i18n import I18nAwareModelSerializer` \u2014 Room is a domain model but its definition depends on an API serializer class",
          "base/models/devices.py line 10: `from eventyay.api.auth.devicesecurity import DEVICE_SECURITY_PROFILES` \u2014 Device model depends on API auth configuration",
          "base/models/auth_token.py line 10: `from eventyay.api.versions import CURRENT_VERSIONS` \u2014 token model hard-coupled to API version list",
          "base/configurations/default_setting.py lines 22-26: `from eventyay.api.serializers.fields import ListMultipleChoiceField, UploadedFileField` and `from eventyay.api.serializers.i18n import I18nField, I18nURLField` \u2014 base settings configuration imports API serializer types",
          "base/shredder.py lines 13-17: `from eventyay.api.serializers.order import ...` and `from eventyay.api.serializers.waitinglist import WaitingListSerializer`"
        ],
        "suggestion": "Extract `I18nAwareModelSerializer` and its i18n helpers to a shared `eventyay.common.serializers` or `eventyay.base.serializers` module so that both `base` models and `api` serializers import from a neutral location. Move `DEVICE_SECURITY_PROFILES` to `base/models/devices.py` or a `base/auth_profiles.py` constant file. Move `CURRENT_VERSIONS` to a standalone `eventyay.api.versions` that has no base dependency, and import the constant into base via a base-owned adapter. For shredder, extract the data-shape logic it needs into a `base`-owned DTO rather than importing API serializers.",
        "reasoning": "",
        "summary_hash": "bbb63adb"
      },
      "status": "fixed",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-03-14T01:19:56+00:00",
      "last_seen": "2026-03-14T01:19:56+00:00",
      "resolved_at": "2026-03-15T05:53:47+00:00",
      "reopen_count": 0,
      "lang": "python",
      "suppressed": false,
