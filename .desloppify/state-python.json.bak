    "review::.::holistic::api_surface_coherence::AC-05": {
      "id": "review::.::holistic::api_surface_coherence::AC-05",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "Sync/async boundary between order services (sync) and user/chat services (async) is undocumented and creates an inconsistent public API",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "app/eventyay/base/services/orders.py",
          "app/eventyay/base/services/user.py",
          "app/eventyay/base/services/chat.py"
        ],
        "evidence": [
          "orders.py: all functions are synchronous",
          "user.py: get_blocked_users, set_user_banned, delete_user, etc. are all @database_sync_to_async",
          "A caller context that is synchronous cannot call user.py functions; a caller context that is async cannot call orders.py functions without running in a thread"
        ],
        "suggestion": "Add module-level docstrings indicating which services are async-only vs sync-only; consider providing thin sync wrappers for the async user service functions used in sync view contexts",
        "reasoning": "",
        "summary_hash": "2baa373a"
      },
      "status": "open",
      "note": null,
