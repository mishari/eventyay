    "review::.::holistic::initialization_coupling::signals_app_cache_unguarded_concurrent_fill": {
      "id": "review::.::holistic::initialization_coupling::signals_app_cache_unguarded_concurrent_fill",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "app_cache in base/signals.py is populated by a non-atomic check-then-set, creating a narrow but real concurrent-fill window",
      "detail": {
        "holistic": true,
        "dimension": "initialization_coupling",
        "related_files": [
          "app/eventyay/base/signals.py"
        ],
        "evidence": [
          "Line 14: 'app_cache = {}' at module scope.",
          "_populate_app_cache() (lines 17-21) is called from send(), send_chained(), and send_robust() each guarded by 'if not app_cache: _populate_app_cache()'.",
          "Between the truthiness check and the dict fill, a second thread could enter _populate_app_cache() and begin iterating app_configs in parallel, producing duplicate writes. While dict.update() in CPython is safe for concurrent writes of the same keys, the window where app_cache is non-empty but incompletely filled could allow resolve_app_for_module() to return incorrect results from a partially filled cache."
        ],
        "suggestion": "Replace the module-level dict with a threading.Lock-protected initialization or use Django's apps.app_configs directly (it is already read-only after startup) instead of maintaining a secondary copy. A simpler fix: initialize app_cache eagerly inside AppConfig.ready() where Django guarantees single-threaded execution, so the dict is fully populated before any requests arrive.",
        "reasoning": "",
        "summary_hash": "c25fd07b"
      },
      "status": "fixed",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-03-14T01:19:56+00:00",
      "last_seen": "2026-03-14T01:19:56+00:00",
      "resolved_at": "2026-03-15T05:53:47+00:00",
