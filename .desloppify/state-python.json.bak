    "review::.::holistic::api_surface_coherence::AC-04": {
      "id": "review::.::holistic::api_surface_coherence::AC-04",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "Two divergent API base mixin patterns (pure DRF vs PretalxViewSetMixin) create inconsistent API surface across subsystems",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "app/eventyay/api/views/order.py",
          "app/eventyay/api/views/speaker.py",
          "app/eventyay/api/mixins.py"
        ],
        "evidence": [
          "OrderViewSet (stable) uses viewsets.ModelViewSet directly with no versioning mixin",
          "SpeakerViewSet (talk) uses PretalxViewSetMixin which handles versioned serializers via get_versioned_serializer()",
          "A developer working on orders would not naturally look for versioning; a developer on speakers would expect it"
        ],
        "suggestion": "Evaluate applying PretalxViewSetMixin or a unified base class to stable API viewsets as well, or document the explicit architectural decision that stable endpoints are version-independent",
        "reasoning": "",
        "summary_hash": "78bd27de"
      },
      "status": "open",
      "note": null,
      "first_seen": "2026-03-15T14:51:53+00:00",
