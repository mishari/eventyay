    "review::.::holistic::logic_clarity::median_off_by_one": {
      "id": "review::.::holistic::logic_clarity::median_off_by_one",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "median_value uses int(round(count / 2)) for odd-length lists, returning the element one position past the true median index",
      "detail": {
        "holistic": true,
        "dimension": "logic_clarity",
        "related_files": [
          "app/eventyay/features/analytics/graphs/utils.py"
        ],
        "evidence": [
          "Lines 77-78: for odd count, the median index should be count // 2 (0-based), but int(round(count / 2)) for any odd count n gives (n+1)/2, which is one past the midpoint. E.g. for count=3: round(1.5)=2, but the median is values[1], not values[2]."
        ],
        "suggestion": "Replace 'int(round(count / 2))' with 'count // 2' to correctly address the middle element of an odd-length sorted list.",
        "reasoning": "",
        "summary_hash": "8ad35db7"
      },
      "status": "wontfix",
      "note": "False positive: analytics/graphs/utils.py:77-78 uses count // 2 which is correct 0-indexed median calculation",
      "first_seen": "2026-03-14T01:19:56+00:00",
      "last_seen": "2026-03-14T01:19:56+00:00",
      "resolved_at": "2026-03-14T14:47:29+00:00",
