      "summary": "UnboundLocalError in SecureOrderQuerySet.get_with_secret_check: 'order' referenced before assignment in except-branch",
      "detail": {
        "holistic": true,
        "dimension": "logic_clarity",
        "related_files": [
          "app/eventyay/base/models/orders.py"
        ],
        "evidence": [
          "Line 93: order = self.get(code=code) raises Order.DoesNotExist before 'order' is assigned.",
          "Line 95: except-branch calls order.tagged_secret(tag, dummy_secret) \u2014 'order' is unbound, producing NameError/UnboundLocalError unconditionally when the order does not exist."
        ],
